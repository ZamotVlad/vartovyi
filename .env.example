APP_NAME=Vartovyi
ENVIRONMENT=local
DEBUG=true
CHECK_TIMEOUT_SECONDS=60
CHECK_MAX_CONCURRENCY=50
INCIDENT_FAILURE_THRESHOLD=2
SCHEDULER_ENABLED=true
DATABASE_URL=postgresql+asyncpg://vartovyi:vartovyi@localhost:5432/vartovyi
REDIS_URL=redis://localhost:6379/0
# Обов'язково поза local, згенерувати: openssl rand -hex 32
# JWT_SECRET_KEY=
LOG_LEVEL=INFO
# json для продакшну, text зручніше читати локально
LOG_FORMAT=text
# CORS_ORIGINS=["http://localhost:3000"]
